# ==============================================================================
# MADHUDHARA (HONEY CHAIN) ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (VITE - EXPOSED TO BROWSER)
# ------------------------------------------------------------------------------
# Vite dev server URL
VITE_APP_URL="http://localhost:3000"
# Backend API Base URL
VITE_API_URL="http://localhost:5000/api"

# Firebase Client Web App Config
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ------------------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (EXPRESS API - SERVER SIDE ONLY)
# ------------------------------------------------------------------------------
# Server Environment & Port
NODE_ENV="development"
PORT=5000

# CORS Allowed Origin (defaults to frontend origin)
CORS_ORIGIN="http://localhost:3000"

# Firebase Admin SDK Configuration (NEVER EXPOSE TO FRONTEND)
# Option A: Absolute or relative path to service account key JSON file
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=""

# Option B: Credentials via environment variables
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 3. FUTURE HARDWARE / BLOCKCHAIN / AI MOCK SERVICES
# ------------------------------------------------------------------------------
DEMO_MODE=true
BLOCKCHAIN_RPC_URL=""
CONTRACT_ADDRESS="0x71C0d21a282496291C2D34091AfeE0b1A7d9BfC4"
RELAYER_PRIVATE_KEY=""
IOT_GATEWAY_URL=""
MQTT_BROKER_URL="mqtt://localhost:1883"
AI_SERVICE_URL="http://localhost:8000"
